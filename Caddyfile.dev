# Local frontend (compose.dev.yml, http://localhost:5500): serves ./frontend straight from disk, so a browser
# reload shows every edit, and proxies /api to the backend running on the host (IDE or `mvn spring-boot:run`).
# Same origin and same relative URLs (./api/...) as production, so no CORS or URL changes are needed.
:80 {
	header Cache-Control no-store

	# The page's runtime settings, from the repository's .env (CARTO_API_KEY: the basemaps key). See Caddyfile.
	handle /config.js {
		header Content-Type "text/javascript; charset=utf-8"
		respond `window.RIVER_LIFELINE_CONFIG = { cartoApiKey: "{$CARTO_API_KEY}" };`
	}

	handle /api/* {
		reverse_proxy {$BACKEND}
	}

	handle {
		root * /srv
		file_server
	}
}
