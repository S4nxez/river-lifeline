FROM docker.io/library/python:3.12-slim

WORKDIR /app
COPY pyproject.toml ./
COPY src ./src
RUN pip install --no-cache-dir --root-user-action=ignore . && useradd --create-home worker && mkdir /data && chown worker /data

USER worker
# Downloaded scenes and trained models: mount a volume here
VOLUME /data
ENTRYPOINT ["python", "-m", "worker"]
